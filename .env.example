# Copy to .env and adjust. Every value here is optional -- the app runs with
# sensible defaults when .env is absent.

# Ports
# Backend (FastAPI + MCP SSE) listens here; the frontend calls it at this port.
# PORT_BACKEND=8001
# Frontend (Vite dev server / preview) listens here.
# PORT_FRONTEND=5173

# Optional: comma-separated browser origins allowed to call the API.
# FRONTEND_HOST=
# Optional: full backend URL when the frontend is served from elsewhere.
# BACKEND_HOST=

# Output token limit for Anthropic requests. Reasoning-capable models spend this
# budget on thinking before writing any answer, so a low value can return a
# response containing only thinking blocks and no text.
#
# Ceilings (Anthropic Models API, `max_tokens`):
#   opus-5, opus-4-8/4-7/4-6, sonnet-5, sonnet-4-6, fable-5/5-1   128000
#   opus-4-5, haiku-4-5, sonnet-4-5                                64000
#
# The 32000 default stays below the ceiling on purpose: a larger budget raises
# per-request timeout risk, and a council round queries several models at once.
# ANTHROPIC_MAX_TOKENS=32000

# Same, for OpenCode (Zen / Go). Default 4096.
# OPENCODE_MAX_TOKENS=4096

# Per-request timeout, in seconds. Reasoning-capable models on hard questions
# can think for well over the previous 120s limit; when the read times out the
# run fails with no answer.
#
# LLM_COUNCIL_REQUEST_TIMEOUT applies to every provider. A provider-specific
# {PROVIDER}_REQUEST_TIMEOUT overrides it -- ANTHROPIC_REQUEST_TIMEOUT,
# OPENAI_REQUEST_TIMEOUT, OPENCODE_ZEN_REQUEST_TIMEOUT, and so on.
#
# The 180s default is deliberately not unbounded: a council round queries
# several models in parallel, and a stalled provider holds its slot for the
# whole timeout. Raise it for the providers that need it rather than globally.
# LLM_COUNCIL_REQUEST_TIMEOUT=180
# ANTHROPIC_REQUEST_TIMEOUT=600
